# Local design data and experiment outputs. Directory markers stay tracked.
# data/gcd/ is the curated OpenROAD GCD dataset from Milestone M1.
data/*
!data/.gitkeep
!data/designs.json
!data/gcd/
!data/gcd/**
!data/corpus/
!data/corpus/**
results/*
!results/.gitkeep

# Learned weights and experiment trackers.
# data/gcd/pyg/graph.pt is the PyG graph object, not a checkpoint.
*.pt
*.pth
!data/gcd/pyg/graph.pt
!data/corpus/**/graph.pt
*.ckpt
*.onnx
*.safetensors
wandb/
lightning_logs/
mlruns/

# Bulky EDA dumps
*.fsdb
*.vcd
*.vpd
*.saif
*.spef
*.sdf
!data/gcd/spef/*.spef
